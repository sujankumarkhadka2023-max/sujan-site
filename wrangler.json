{
  "name": "sujan-site",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/img/*",
      "/audio/*",
      "/video/*",
      "/",
      "/world",
      "/opinion",
      "/history",
      "/culture",
      "/audio",
      "/videos",
      "/horoscope",
      "/weather",
      "/world/*",
      "/opinion/*",
      "/history/*",
      "/culture/*",
      "/listen/*",
      "/tools"
    ]
  }
}
