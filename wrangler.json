{
  "name": "sujan-site",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/img/*",
      "/audio/*",
      "/video/*",
      "/",
      "/sitemap.xml",
      "/world",
      "/opinion",
      "/history",
      "/culture",
      "/audio",
      "/videos",
      "/horoscope",
      "/weather",
      "/world/*",
      "/opinion/*",
      "/history/*",
      "/culture/*",
      "/listen/*",
      "/tools",
      "/lifestyle",
      "/lifestyle/*",
      "/explore",
      "/tools/*",
      "/rates",
      "/calculators",
      "/calculators/*",
      "/learn",
      "/learn/*",
      "/exercise",
      "/resume",
      "/trek-planner",
      "/p/*"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "CHAT",
        "class_name": "ChatRoom"
      },
      {
        "name": "GROUP",
        "class_name": "GroupRoom"
      },
      {
        "name": "USER",
        "class_name": "ChatUser"
      },
      {
        "name": "PUSH",
        "class_name": "PushHub"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "ChatRoom"
      ]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": [
        "GroupRoom"
      ]
    },
    {
      "tag": "v3",
      "new_sqlite_classes": [
        "ChatUser"
      ]
    },
    {
      "tag": "v4",
      "new_sqlite_classes": [
        "PushHub"
      ]
    }
  ],
  "vars": {
    "GOOGLE_CLIENT_ID": "379531909325-s1f64s01v8rvd1hkmpqjeehql4n1msaa.apps.googleusercontent.com"
  }
}